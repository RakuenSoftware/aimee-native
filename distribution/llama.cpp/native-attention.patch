              int64_t   n_kv_max,
                float   kq_scale,
                  int   il) const {
+    if (cparams.native_attention) {
+        // The first binding intentionally supports one sequence. Batch/session
+        // mappings must be explicit before enabling shared inference contexts.
+        // Compressed attention needs its own provider contract; never silently
+        // reinterpret those states as ordinary K/V.
+        if (ubatch.n_seqs_unq != 1 || kq_b != nullptr || v_mla != nullptr) {
+            throw std::runtime_error("native attention configuration unsupported");
+        }
+        const int status = cparams.native_attention(
+            cparams.native_attention_user_data, ctx0, il,
+            &q, &k, &v, &kq_mask, &n_kv_max);
+        if (status != 0 || q == nullptr || k == nullptr || v == nullptr) {
+            throw std::runtime_error("native attention provider failed");
+        }
+    }
     const bool v_trans = v->nb[1] > v->nb[2];
 

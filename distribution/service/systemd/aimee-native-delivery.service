[Unit]
Description=Aimee private native-memory delivery
After=network.target

[Service]
Type=simple
User=aimee
Group=aimee
RuntimeDirectory=aimee-native
RuntimeDirectoryMode=0700
StateDirectory=aimee-native
StateDirectoryMode=0700
UMask=0077
ExecStart=/opt/aimee-native/bin/aimee-native-delivery --socket /run/aimee-native/delivery.sock --bindings /etc/aimee-native/bindings.json
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/aimee-native /run/aimee-native
# The private preparer and its CPU model runtime are installed under /opt;
# credentials, scopes and release policies are managed by Aimee's control plane.
Environment=AIMEE_NATIVE_LIBRARY=/opt/aimee-native/lib/libaimee_private.so
Environment=HF_HUB_OFFLINE=1
Environment=HF_HOME=/var/lib/aimee-native/hf
LimitNOFILE=4096
TimeoutStopSec=15
KillMode=control-group

[Install]
WantedBy=multi-user.target

[
  "runuser",
  "-u",
  "memory-model",
  "--",
  "env",
  "LD_LIBRARY_PATH=/opt/aimee-memory-lab/venv/lib/python3.13/site-packages/torch/lib",
  "OMP_NUM_THREADS=8",
  "MKL_NUM_THREADS=8",
  "/opt/aimee-memory-lab/aimee-qwen/target/release/aimee-qwen",
  "serve",
  "--model",
  "/opt/aimee-memory-lab/model",
  "--placement",
  "/opt/aimee-memory-lab/aimee-qwen/integrations/qwen_aimee/placement-dual7900xtx-int8.json",
  "--int8",
  "--memory-image",
  "/opt/aimee-memory-lab/native-scale-corrections-r2/image",
  "--image-reader",
  "/opt/aimee-memory-lab/aimee-qwen/.local/bin/aimee-memory-image",
  "--read-gateway",
  "/opt/aimee-memory-lab/native-scale-corrections-qwen-r1/empty-upstream.sock",
  "--read-authority",
  "test",
  "--memory-limit",
  "4",
  "--trace-dir",
  "/opt/aimee-memory-lab/native-scale-corrections-qwen-r1/traces",
  "--encoding-cache-mib",
  "256",
  "--enable-record-encoding"
]